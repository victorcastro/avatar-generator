<!doctype html>
<html lang="en" data-theme="dark">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <meta name="description" content="Generate standardized community avatars with a circular template, role badges, and instant PNG export.">
      <title>Community Avatar Generator</title>
      <link rel="canonical" href="https://victorcastro.github.io/avatar-generator/">
      <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
      <link rel="icon" href="assets/favicon-32.png" sizes="32x32" type="image/png">
      <link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
      <meta name="theme-color" content="#c8102e">
      <meta property="og:locale" content="en_US">
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="Community Avatar Generator">
      <meta property="og:title" content="Community Avatar Generator">
      <meta property="og:description" content="Generate standardized community avatars with a circular template, role badges, and instant PNG export.">
      <meta property="og:url" content="https://victorcastro.github.io/avatar-generator/">
      <meta property="og:image" content="https://victorcastro.github.io/avatar-generator/assets/og-image.png">
      <meta property="og:image:type" content="image/png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="Community Avatar Generator">
      <meta name="twitter:description" content="Generate standardized community avatars with a circular template, role badges, and instant PNG export.">
      <meta name="twitter:image" content="https://victorcastro.github.io/avatar-generator/assets/og-image.png">
      <link rel="stylesheet" href="/node_modules/@picocss/pico/css/pico.red.min.css">
      <link rel="stylesheet" href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css">
      <link rel="stylesheet" href="styles/styles.css">
    </head>
  <body>
    <main class="shell container-fluid">
      <section class="hero-panel">
        <div class="hero-actions">
          <span class="site-version" aria-label="Website version">v{{appVersion}}</span>
          <a
            class="repo-link"
            href="https://github.com/victorcastro/avatar-generator"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Open GitHub repository"
            title="GitHub repository"
          >
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            <span class="repo-link__text">Source Code</span>
          </a>
        </div>
        <p class="eyebrow">Node.js Utility</p>
        <div class="hero-copy">
          <div>
            <h1>Community Avatar Generator</h1>
            <p>Standardize community avatars with a circular template, consistent icons, and immediate PNG export.</p>
          </div>
        </div>
      </section>

      <div class="workspace">
        <article class="controls-card">
          <section class="setup-card">
            <header class="setup-card__header">
              <span class="step-badge">1</span>
              <div class="setup-card__heading">
                <h2>Template and name</h2>
              </div>
            </header>

            <div class="controls-stack">
              <div class="field-group">
                <h3 class="field-group__title" id="labelFieldTitle">Label</h3>
                <div class="input-block">
                  <input id="titleText" name="titleText" type="text" maxlength="64" aria-labelledby="labelFieldTitle" autofocus>
                  <span class="char-counter" id="titleTextCounter">0/64</span>
                </div>
              </div>

              <div class="field-group">
                <h3 class="field-group__title" id="iconFieldTitle">Icon</h3>
                <div class="role-chips" id="role" role="radiogroup" aria-labelledby="iconFieldTitle">
                  <label class="role-chip">
                    <input type="radio" name="role" value="ios" checked>
                    <span><i class="role-chip__dot" aria-hidden="true"></i>iOS</span>
                  </label>
                  <label class="role-chip">
                    <input type="radio" name="role" value="android">
                    <span><i class="role-chip__dot" aria-hidden="true"></i>Android</span>
                  </label>
                  <label class="role-chip">
                    <input type="radio" name="role" value="react">
                    <span><i class="role-chip__dot" aria-hidden="true"></i>React</span>
                  </label>
                  <label class="role-chip">
                    <input type="radio" name="role" value="qa">
                    <span><i class="role-chip__dot" aria-hidden="true"></i>QA</span>
                  </label>
                </div>
                <label class="field-group__toggle" for="hideIcon">
                  <span class="switch">
                    <input id="hideIcon" name="hideIcon" type="checkbox">
                    <span class="switch__track"></span>
                  </span>
                  <span>No icon</span>
                </label>
              </div>

              <div class="field-group">
                <h3 class="field-group__title" id="dividerFieldTitle">Divider color</h3>
                <div class="swatches" id="dividerSwatches" role="radiogroup" aria-labelledby="dividerFieldTitle"></div>
                <input
                  class="hex-input"
                  id="dividerHex"
                  name="dividerHex"
                  type="text"
                  maxlength="7"
                  spellcheck="false"
                  autocomplete="off"
                  aria-label="Divider color as hexadecimal"
                >
              </div>

              <div class="field-group">
                <h3 class="field-group__title" id="labelBackgroundFieldTitle">Label background</h3>
                <div class="swatches" id="labelBackgroundSwatches" role="radiogroup" aria-labelledby="labelBackgroundFieldTitle"></div>
                <input
                  class="hex-input"
                  id="labelBackgroundHex"
                  name="labelBackgroundHex"
                  type="text"
                  maxlength="7"
                  spellcheck="false"
                  autocomplete="off"
                  aria-label="Label background as hexadecimal"
                >
              </div>
            </div>
          </section>

          <section class="setup-card">
            <header class="setup-card__header">
              <span class="step-badge">2</span>
              <div class="setup-card__heading">
                <h2>Portrait image</h2>
                <p class="setup-card__subtitle">Either image on its own is enough to export.</p>
              </div>
            </header>

            <div class="tuning-column">
              <div class="dropzone" id="portraitDropzone" data-layer="portrait">
                <input id="portraitUpload" name="portraitUpload" class="dropzone__input" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp">
                <label class="dropzone__label" for="portraitUpload">
                  <span class="dropzone__icon" data-lucide="image" aria-hidden="true"></span>
                  <span class="dropzone__text">
                    <span class="dropzone__title">Portrait</span>
                    <span class="dropzone__formats">PNG · JPG · WEBP</span>
                  </span>
                  <span class="dropzone__upload-btn">Upload</span>
                </label>
                <div class="dropzone__status">
                  <p class="dropzone__file" id="portraitFileName" hidden></p>
                  <button class="dropzone__clear" id="portraitClear" type="button" hidden aria-label="Remove the portrait image" title="Remove image">
                    <span data-lucide="x" aria-hidden="true"></span>
                  </button>
                </div>
              </div>

              <div class="cutout-block">
                <label class="cutout-block__toggle" for="portraitCutout">
                  <span class="switch">
                    <input id="portraitCutout" name="portraitCutout" type="checkbox" checked aria-describedby="portraitCutoutStatus">
                    <span class="switch__track"></span>
                  </span>
                  <span>Remove background</span>
                </label>
                <p class="cutout-block__status" id="portraitCutoutStatus" hidden></p>
              </div>

              <div class="range-block">
                <label for="portraitScale">Zoom</label>
                <input id="portraitScale" name="portraitScale" type="range" min="0.25" max="1.8" step="0.01" value="1">
              </div>
            </div>
          </section>

          <section class="setup-card">
            <header class="setup-card__header">
              <span class="step-badge">3</span>
              <div class="setup-card__heading">
                <h2>Background image</h2>
                <p class="setup-card__subtitle">Hold Alt while dragging to move it on the canvas.</p>
              </div>
            </header>

            <div class="tuning-column">
              <div class="dropzone" id="backgroundDropzone" data-layer="background">
                <input id="backgroundUpload" name="backgroundUpload" class="dropzone__input" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp">
                <label class="dropzone__label" for="backgroundUpload">
                  <span class="dropzone__icon" data-lucide="image" aria-hidden="true"></span>
                  <span class="dropzone__text">
                    <span class="dropzone__title">Background</span>
                    <span class="dropzone__formats">PNG · JPG · WEBP</span>
                  </span>
                  <span class="dropzone__upload-btn">Upload</span>
                </label>
                <div class="dropzone__status">
                  <p class="dropzone__file" id="backgroundFileName" hidden></p>
                  <button class="dropzone__clear" id="backgroundClear" type="button" hidden aria-label="Remove the background image" title="Remove image">
                    <span data-lucide="x" aria-hidden="true"></span>
                  </button>
                </div>
              </div>

              <div class="range-block">
                <label for="backgroundScale">Zoom</label>
                <input id="backgroundScale" name="backgroundScale" type="range" min="0.25" max="1.8" step="0.01" value="1">
              </div>
            </div>
          </section>
        </article>

        <article class="preview-card">
          <div class="canvas-frame" id="canvasFrame">
            <button id="downloadButton" class="canvas-download" type="button" aria-label="Download PNG" title="Download PNG">
              <span class="download-button__label">Download</span>
              <span data-lucide="download"></span>
            </button>

            <canvas
              id="avatarCanvas"
              width="640"
              height="640"
              tabindex="0"
              role="img"
              aria-label="Avatar preview"
              aria-describedby="canvasHint"
              aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight Alt"></canvas>

            <p id="canvasHint" class="canvas-hint">Add a portrait or a background to start composing</p>
          </div>

          <p id="canvasStatus" class="sr-only" role="status" aria-live="polite"></p>
        </article>
      </div>
    </main>

    <script type="importmap">
      {
        "imports": {
          "onnxruntime-web": "/node_modules/onnxruntime-web/dist/ort.wasm.bundle.min.mjs"
        }
      }
    </script>
    <script>window.AVATAR_BACKGROUND_REMOVAL_URL = "/node_modules/@imgly/background-removal/dist/index.mjs";</script>
    <script src="/node_modules/lucide/dist/umd/lucide.min.js"></script>
    <script type="module" src="scripts/main.js"></script>
  </body>
</html>
